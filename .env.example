# Access point: NOME|IP|metodo (snmp o ssh), separati da virgola
APS=ZONA NOTTE|192.168.1.11|ssh,SOGGIORNO|192.168.1.12|ssh,GARAGE|192.168.1.13|snmp,GIARDINO|192.168.1.14|snmp

# SNMP v2c (Nebula → Site-wide → Configure → General settings → SNMP access)
SNMP_COMMUNITY=public

# SSH per gli AP senza SNMP (credenziali "Local credentials" di Nebula)
SSH_USER=admin
SSH_PASSWORD=

# OPNsense (facoltativo): nomi dai lease DHCP e siti visitati dal DNS di Unbound
OPNSENSE_URL=
OPNSENSE_KEY=
OPNSENSE_SECRET=
OPNSENSE_VERIFY_TLS=true
# interfaccia verso Internet (Interfaces → Assignments), es. wan oppure opt1
OPNSENSE_WAN_IF=wan
# dominio della LAN, escluso dai "siti visitati"
LOCAL_DOMAIN=

POLL_INTERVAL=60
RETENTION_DAYS=30

# Chiave per firmare le sessioni: generala con  python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=cambia-questa-chiave

# Copie notturne del database (vuoto = cartella "backups" accanto al DB). Montaci una cartella del NAS.
BACKUP_DIR=
